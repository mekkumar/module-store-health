<?xml version="1.0"?>

<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">

    <system>

        <tab id="kumar"
             translate="label"
             sortOrder="900">

            <label>Kumar</label>

        </tab>

        <section id="kumar_storehealth"
                 translate="label"
                 sortOrder="900"
                 showInDefault="1"
                 showInWebsite="1"
                 showInStore="1">

            <label>StoreHealth AI</label>

            <tab>kumar</tab>

            <resource>Kumar_StoreHealth::dashboard</resource>

            <group id="general"
                   translate="label"
                   sortOrder="10"
                   showInDefault="1"
                   showInWebsite="1"
                   showInStore="1">

                <label>General</label>

                <field id="enabled"
                       translate="label"
                       type="select"
                       sortOrder="10"
                       showInDefault="1"
                       showInWebsite="1"
                       showInStore="1">

                    <label>Enable StoreHealth AI</label>

                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>

                </field>

            </group>

        </section>

    </system>

</config>
